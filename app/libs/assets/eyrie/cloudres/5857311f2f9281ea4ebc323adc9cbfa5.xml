<!--骑步行终点室内楼层-->
<xml>
  <params>
    <param useCommonParser='true' direction='rightTop' anchorOffset='(0,-12)'>
      <subparam
        id='divparam1'
        align-self='flex-start'
        padding='10px 10px 10px 30px'
      ></subparam>
    </param>

    <param useCommonParser='true' direction='leftTop' anchorOffset='(0,-12)'>
      <subparam
        id='divparam1'
        align-self='flex-end'
        padding='10px 30px 10px 10px'
      ></subparam>
    </param>
  </params>

  <div style='display: flex; flex-direction: row; align-items: flex-end'>
    <div id='divparam1' style='display: flex; flex-direction: column'>
      <label
        style='font-size: 26px; line-height: 30px; padding-left: 1px; font-weight: bold; color: @Color_Black; text-overflow: ellipsis; overflow: hidden; position: relative; text-stroke: 2px @Color_BG_L2'
        text='{label}'
      ></label>
    </div>
  </div>
</xml>

<!--骑步行终点营业时间气泡_30303-->
<xml>
  <params>
    <param useCommonParser='true' direction='topCenter' anchorOffset='(0,-63)'>
      <subparam
        id='backimage'
        background-image='231451'
        backgroundstretch='40% 44% 40% 44%'
        padding='9px 12px 11px 12px'
      ></subparam>
    </param>
  </params>

  <div style='display: flex; flex-direction: row'>
    <div
      id='backimage'
      style='display: flex; align-items: flex-start; margin-start: 0px; flex-direction: column'
    >
      <div style='flex-direction: row'>
        <div style='align-self: center; margin-right: 0px; margin-left: 0px; flex-direction: column'>
          <label
            style='font-size: 24px; color: @Color_White'
            text='{label}'
          ></label>

          <label
            style='display: {subDisplay}; font-size: 18px; color: @Color_White'
            text='{subLabel}'
          ></label>
        </div>
      </div>
    </div>
  </div>
</xml>

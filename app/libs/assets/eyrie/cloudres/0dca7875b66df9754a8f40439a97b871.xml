<xml><params><param useCommonParser="true" direction="leftCenter" anchorOffset="(32,32)"><subparam id="maindiv" flex-direction="row-reverse"></subparam><subparam id="firstdiv" align-items="flex-end"></subparam><subparam id="firstlabel" text-align="right"></subparam></param><param useCommonParser="true" direction="rightCenter" anchorOffset="(32,32)"><subparam id="maindiv" flex-direction="row"></subparam><subparam id="firstdiv" align-items="flex-start"></subparam><subparam id="firstlabel" text-align="left"></subparam></param></params><div id="maindiv" style="display: flex; align-items: center"><image style="width: 64px; height: 64px" src="{icon}"></image><div id="firstdiv" style="display: flex; flex-direction: column"><label id="firstlabel" style="font-size: 28px; color: @Color_Text_L1; line-height: 36px; text-layout-amap: Y; max-width: 196px; font-weight: bold; text-stroke: 2px; line-clamp: 2" text="{poiName}"></label><div style="align-items: center; background-color: {labelBG}; border-radius: 8px; margin-left: 4px; margin-right: 4px; flex-direction: column"><label style="font-weight: bold; font-size: 24px; color: {labelColor}" text="{label}"></label></div></div></div></xml>
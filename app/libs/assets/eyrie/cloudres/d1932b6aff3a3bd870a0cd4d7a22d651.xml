<!--LaneNaviActionNext-->
<xml>
  <params>
    <param
      useCommonParser='true'
      direction='leftCenter'
      anchorOffset='(-15,0)'
      anchorOffsetHD='(15,18)'
    >
      <subparam id='lineStylePath' name='path' path='(45,0)'></subparam>

      <subparam id='whiteLineStylePath' name='path' path='(45,3)'></subparam>
    </param>

    <param
      useCommonParser='true'
      direction='rightCenter'
      anchorOffset='(-15,0)'
      anchorOffsetHD='(15,18)'
    >
      <subparam id='lineStylePath' name='path' path='(-45,0)'></subparam>

      <subparam id='whiteLineStylePath' name='path' path='(-45,3)'></subparam>
    </param>
  </params>

  <div
    id='animationId'
    style='display: flex; flex-direction: row'
    animation='{collisionshowanimation}: animationkey'
    animationkey='type: 2; duration: 200; count: 1; from: {collisionFromX} {collisionFromY} 0; to: 0 0 0'
  >
    <line
      id='whiteLineStylePath'
      style='width: 4px; background-color: #B3FFFFFF'
      offset-start-pos='(0,3)'
      path-start-pos='Y'
    ></line>

    <line
      id='lineStylePath'
      style='width: 4px; background-image: linear-gradient(to left,@Color_Hue230_L6,@Color_Hue230_L6)'
      path-start-pos='Y'
    ></line>

    <div
      style='top: 0px; left: 0; backgroundstretch: 45% 25% 46% 70%; background-image: 171067; padding: 47px 26px 47px 12px'
      syncload='true'
    >
      <div style='display: flex; position: relative; align-items: center; flex-direction: row'>
        <div
          style='display: flex; width: 84px; height: 84px; align-items: center; flex-direction: row; justify-content: center; margin-right: 6px; background-image: 171040'
          syncload='true'
        >
          <img
            style='width: 70px; height: 70px; align-self: center'
            src='{actionIcon}'
            syncload='true'
            syncloadCache='false'
            fastmode='false'
          ></img>
        </div>

        <label
          style='margin-top: 2px; margin-right: 4px; line-height: 32px; white-space: nowrap; color: @Color_BG_L1; font-size: 32px; font-weight: bold; align-self: center'
          text='随后'
        ></label>

        <img
          style='width: 48px; height: 48px; align-self: center'
          src='{nextactionIcon}'
          syncload='true'
          syncloadCache='false'
          fastmode='false'
        ></img>
      </div>
    </div>
  </div>
</xml>

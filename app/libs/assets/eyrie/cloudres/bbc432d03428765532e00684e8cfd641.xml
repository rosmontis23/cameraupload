<!--骑步行动作提示气泡-->
<xml>
  <params>
    <param useCommonParser='true' direction='leftTop' anchorOffset='(0,0)'>
      <subparam
        id='backimage'
        background-image='10059'
        backgroundstretch='32% 36% 32% 36%'
        padding='22px 22px 22px 22px'
      ></subparam>
    </param>

    <param useCommonParser='true' direction='rightTop' anchorOffset='(0,0)'>
      <subparam
        id='backimage'
        background-image='10058'
        backgroundstretch='32% 36% 32% 36%'
        padding='22px 22px 22px 22px'
      ></subparam>
    </param>

    <param useCommonParser='true' direction='leftBottom' anchorOffset='(0,0)'>
      <subparam
        id='backimage'
        background-image='10057'
        backgroundstretch='32% 36% 32% 36%'
        padding='22px 22px 22px 22px'
      ></subparam>
    </param>

    <param useCommonParser='true' direction='rightBottom' anchorOffset='(0,0)'>
      <subparam
        id='backimage'
        background-image='10056'
        backgroundstretch='32% 36% 32% 36%'
        padding='22px 22px 22px 22px'
      ></subparam>
    </param>
  </params>

  <div
    id='backimage'
    style='display: flex; justify-content: center; align-items: center; flex-direction: row'
  >
    <img
      style='width: 48px; height: 49px; margin-right: 6px; align-self: center'
      src='{iconId}'
      syncload='true'
      syncloadCache='false'
      fastmode='false'
    ></img>

    <div style='display: flex; align-items: flex-start; flex-direction: row; margin-top: -1px; font-weight: bold; line-height: 28px; white-space: nowrap'>
      <label
        style='color: @Color_Text_L1; font-size: 24px; margin-right: 0px; font-weight: bold; align-self: flex-start'
        text='{label}'
      ></label>
    </div>
  </div>
</xml>

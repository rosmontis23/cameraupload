<!--灵活标注车道级动作距离气泡白天 LaneNaviActionDistanceDay-->
<xml>
  <params>
    <param
      useCommonParser='true'
      direction='leftCenter'
      anchorOffset='(-15,0)'
      anchorOffsetHD='(15,18)'
    >
      <subparam id='whiteLineStylePath' name='path' path='(45,3)'></subparam>

      <subparam id='lineStylePath' name='path' path='(45,0)'></subparam>

      <subparam
        id='labBackground'
        flex-direction='row'
        backgroundstretch='45% 70% 46% 25%'
        padding='47px 12px 49px 34px'
      ></subparam>
    </param>

    <param
      useCommonParser='true'
      direction='rightCenter'
      anchorOffset='(-15,0)'
      anchorOffsetHD='(15,18)'
    >
      <subparam id='whiteLineStylePath' name='path' path='(-45,3)'></subparam>

      <subparam id='lineStylePath' name='path' path='(-45,0)'></subparam>

      <subparam
        id='labBackground'
        backgroundstretch='45% 70% 46% 25%'
        padding='47px 12px 49px 34px'
        flex-direction='row-reverse'
        backgroundtransform='rotate(0,180,0)'
      ></subparam>
    </param>
  </params>

  <div
    id='animationId'
    style='display: flex; flex-direction: row'
    animation='{collisionshowanimation}: animationkey'
    animationkey='type: 2; duration: 200; count: 1; from: {collisionFromX} {collisionFromY} 0; to: 0 0 0'
  >
    <line
      id='whiteLineStylePath'
      style='width: 4px; background-color: #B3FFFFFF'
      offset-start-pos='(0,3)'
      path-start-pos='Y'
    ></line>

    <line
      id='lineStylePath'
      style='width: 4px; background-image: linear-gradient(to left,@Color_Hue230_L6,@Color_Hue230_L6)'
      path-start-pos='Y'
    ></line>

    <div
      id='labBackground'
      style='top: 0px; left: 0; background-image: 171065'
      syncload='true'
    >
      <div style='display: flex; position: relative; align-items: center; flex-direction: row; white-space: nowrap'>
        <label
          style='margin-right: 6px; line-height: 42px; font-weight: bold; color: @Color_BG_L1; font-family: AmapNumber-Bold; font-size: 44px; align-self: center'
          text='{distance}'
        ></label>

        <label
          style='margin-right: 2px; line-height: 30px; font-weight: bold; color: @Color_BG_L1; font-size: 30px; align-self: center; margin-top: 4px'
          text='米'
        ></label>
      </div>

      <div
        style='display: flex; width: 82px; height: 82px; background-size: contain; align-items: center; flex-direction: row; justify-content: center; background-image: 171040; white-space: normal'
        syncload='true'
      >
        <img
          style='width: 70px; height: 70px; align-self: center'
          src='{actionIcon}'
          syncload='true'
          syncloadCache='false'
          fastmode='false'
        ></img>
      </div>
    </div>
  </div>
</xml>

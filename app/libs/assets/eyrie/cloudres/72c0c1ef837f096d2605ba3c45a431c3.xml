<!--D2C预览生成-->
<xml>
  <params>
    <param useCommonParser='true' direction='leftTop' anchorOffset='(17,22)'>
      <subparam
        id='backgroundProperty'
        background-image='231318'
        backgroundstretch='29% 42% 53% 44%'
        padding='22px 42px 46px 27px'
      ></subparam>
    </param>

    <param useCommonParser='true' direction='rightTop' anchorOffset='(17,22)'>
      <subparam
        id='backgroundProperty'
        background-image='231319'
        backgroundstretch='29% 42% 53% 44%'
        padding='22px 28px 46px 41px'
      ></subparam>
    </param>

    <param useCommonParser='true' direction='leftBottom' anchorOffset='(17,22)'>
      <subparam
        id='backgroundProperty'
        background-image='231320'
        backgroundstretch='53% 44% 29% 42%'
        padding='38px 41px 29px 27px'
      ></subparam>
    </param>

    <param
      useCommonParser='true'
      direction='rightBottom'
      anchorOffset='(17,22)'
    >
      <subparam
        id='backgroundProperty'
        background-image='231321'
        backgroundstretch='37% 42% 53% 44%'
        padding='38px 25px 29px 41px'
      ></subparam>
    </param>

    <param useCommonParser='true' direction='topCenter' anchorOffset='(0,18)'>
      <subparam
        id='backgroundProperty'
        background-image='231322'
        backgroundstretch='40% 60% 50% 25% 50% 25% 40% 60%'
        padding='20px 28px 45px 27px'
      ></subparam>
    </param>

    <param
      useCommonParser='true'
      direction='bottomCenter'
      anchorOffset='(0,18)'
    >
      <subparam
        id='backgroundProperty'
        background-image='231323'
        backgroundstretch='40% 60% 50% 25% 50% 25% 40% 60%'
        padding='35px 28px 29px 28px'
      ></subparam>
    </param>
  </params>

  <div
    id='backgroundProperty'
    style='display: flex; align-items: center; justify-content: center; flex-direction: row'
  >
    <div style='display: flex; position: relative; align-items: center; flex-direction: row'>
      <img
        style='width: 58px; height: 58px; border-radius: 8px'
        src='{iconUrl}'
        serviceresize='true'
        syncloadCache='false'
        fastmode='false'
      ></img>
    </div>

    <div
      style='display: flex; align-items: flex-start; flex-direction: column; margin-left: 8px; font-weight: bold; white-space: nowrap'
      class='d2c_sub'
    >
      <div style='display: flex; flex-direction: row; align-items: center; justify-content: center; border-radius: 8px; background-color: {labelBgColor}'>
        <label
          style='display: flex; color: {labelColor}; font-size: 24; line-height: 24px; font-weight: normal; margin: 4px 4px 4px 4px'
          text='{label}'
        ></label>
      </div>

      <div style='display: {subDisplay}; align-items: flex-start; justify-content: center; flex-direction: column; margin-top: 4px'>
        <label
          style='display: flex; color: {subLabelColor}; font-size: 22px; line-height: 22px; font-weight: normal; opacity: 0.6'
          text='{subLabel}'
        ></label>
      </div>
    </div>

    <div style='display: {arrowDisplay}; flex-direction: row; align-items: center; margin-left: 10px; position: relative'>
      <img
        style='width: 20px; height: 20px'
        src='800003'
        syncloadCache='false'
        fastmode='false'
      ></img>
    </div>
  </div>
</xml>

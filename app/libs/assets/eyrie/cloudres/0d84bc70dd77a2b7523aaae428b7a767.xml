<!--行后巡航停车场气泡高亮态-->
<xml>
  <params>
    <param direction='rightTop' anchorOffset='(56,0)'>
      <subparam
        id='backgroundProperty'
        background-image='800001'
        backgroundstretch='52% 25% 42% 30%'
        padding='14px 20px 20px 52px'
      ></subparam>

      <subparam id='bgRoot' left='52px'></subparam>

      <subparam id='nameLable' align-self='flex-start'></subparam>

      <subparam id='chargeLable' align-self='flex-start'></subparam>

      <subparam id='image' left='0px'></subparam>
    </param>

    <param direction='leftTop' anchorOffset='(56,0)'>
      <subparam
        id='backgroundProperty'
        background-image='800001'
        backgroundstretch='54% 25% 40% 30%'
        padding='14px 52px 20px 20px'
        backgroundtransform='rotate(0,180,0)'
      ></subparam>

      <subparam id='bgRoot' right='52px'></subparam>

      <subparam id='nameLable' align-self='flex-end'></subparam>

      <subparam id='chargeLable' align-self='flex-end'></subparam>

      <subparam id='image' right='0px'></subparam>
    </param>
  </params>

  <div style='flex-direction: column; justify-content: center; align-items: center'>
    <div
      id='bgRoot'
      style='position: relative; align-items: center; flex-direction: row; top: {focusBgTop}px'
    >
      <div id='backgroundProperty' style='position: relative'>
        <label
          id='nameLable'
          style='color: @Color_Black; font-size: 28px; line-height: 28px; font-weight: bold'
          text='{mainLabel}'
        ></label>

        <div
          id='chargeLable'
          style='justify-content: center; flex-direction: row'
        >
          <label
            style='display: {sub1Display}; color: {sub1Color}; font-size: 24px; line-height: 24px; max-width: 195px; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; line-clamp: 1'
            text='{sub1label}'
          ></label>

          <label
            style='display: {sub2Display}; color: {sub2Color}; font-size: 24px; line-height: 24px; max-width: 195px; overflow: hidden; text-overflow: ellipsis; margin-left: 6px; margin-top: 2px; line-clamp: 1'
            text='{sub2label}'
          ></label>
        </div>
      </div>
    </div>

    <img
      id='image'
      style='width: 112px; height: 118px; position: absolute; bottom: 0px'
      src='10208'
      syncloadCache='false'
      fastmode='false'
    ></img>
  </div>
</xml>
